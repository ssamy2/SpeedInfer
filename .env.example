# =============================================================================
# SpeedInfer Environment Configuration Template
# =============================================================================

# Application Metadata
APP_NAME=SpeedInfer
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection
# SQLite (development): sqlite:///./data/speedinfer.db
# PostgreSQL (production): postgresql+asyncpg://speedinfer:speedinfer_password@postgres:5432/speedinfer
DATABASE_URL=sqlite:///./data/speedinfer.db

# Redis Connection (Token-bucket rate limiting & atomic balance deduction)
# Local: redis://localhost:6379/0
# Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Security Pepper for HMAC-SHA256 API Key Hashing (Minimum 16 characters required)
# Generate via: openssl rand -hex 32
API_KEY_PEPPER=replace-with-a-random-32-byte-secret

# Inference Engine (vLLM) Configuration
DEFAULT_MODEL=Qwen/Qwen2.5-7B-Instruct
# Docker topology upstream: http://vllm:8000
# Bare-metal upstream: http://localhost:8001
VLLM_BASE_URL=http://vllm:8000
VLLM_TIMEOUT_SECONDS=120
MAX_REQUEST_TOKENS=32768

# Metering and Token Pricing (USD per 1,000,000 tokens)
PROMPT_PRICE_PER_MILLION=0.20
COMPLETION_PRICE_PER_MILLION=0.60

# Public Base URL and Ingress
PUBLIC_BASE_URL=https://api.example.com

# MLflow Experiment Tracking (Optional, for training/fine-tuning pipeline)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=speedinfer-finetuning

# Sales and support intake (requests are saved even when SMTP is unavailable)
# Sales spelling follows the supplied address; change if the domain was a typo.
SALES_EMAIL=Sales@speedinfer.com
SUPPORT_EMAIL=Support@speedinfer.com
# Configure a verified sender and TLS-enabled SMTP provider to notify team inboxes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# false uses mandatory STARTTLS; true uses implicit TLS (normally port 465).
SMTP_IMPLICIT_TLS=false
SMTP_TIMEOUT_SECONDS=10

# Whop hosted checkout. Keep these values only on the server, never in frontend files.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_ACCOUNT_ID=
WHOP_API_VERSION_DATE=2026-09-25
WHOP_CREDIT_PACKAGES=10,25,50,100
# Fixed signup trial; request bodies cannot increase it.
TRIAL_CREDIT_BALANCE=10
